DATABASE_URL="postgresql://postgres:password@localhost:5432/cms_db?schema=public"

# Supabase production:
#   DATABASE_URL = transaction pooler, cổng 6543 — app dùng lúc chạy
#   DIRECT_URL   = session pooler,     cổng 5432 — chỉ `prisma migrate deploy` dùng
# Bỏ trống DIRECT_URL thì migration dùng luôn DATABASE_URL (đúng cho Postgres local).
DIRECT_URL=

# Kích thước pool của app. Mặc định (6 / 30000) an toàn cho session pooler
# (trần 15 client). Sau khi DATABASE_URL đã sang cổng 6543 thì đặt 10 / 0.
DATABASE_POOL_MAX=
DATABASE_POOL_IDLE_TIMEOUT_MS=

# Bỏ trống = cache trong bộ nhớ, chỉ đúng khi chạy MỘT instance.
# Chạy từ hai instance trở lên thì BẮT BUỘC có Redis dùng chung.
REDIS_URL=

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

PORT=9999
NODE_ENV=development

# "Sign in with Google" login/register flow.
# Setup: https://console.cloud.google.com/ -> OAuth consent screen -> Credentials
# -> OAuth client ID (Web application) -> add GOOGLE_OAUTH_LOGIN_CALLBACK_URL
# under Authorized redirect URIs. Leave blank to disable Google login.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_LOGIN_CALLBACK_URL=http://localhost:8888/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Public URL of this deployment (e.g. https://your-app.onrender.com). When set,
# a cron job pings /health every minute so the free-tier instance doesn't spin down.
APP_URL=

# Số tầng proxy đứng trước app (Express `trust proxy`). Render = 1 (mặc định).
# Sai số này thì `req.ip` là IP của load balancer và rate limit cho route Public
# (đăng nhập…) bị dùng chung giữa mọi người. Chạy trực tiếp không qua proxy: 0.
TRUST_PROXY_HOPS=

# Rate limit mặc định (route đã đăng nhập đếm theo user, route Public theo IP).
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=20
