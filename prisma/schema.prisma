// Prisma schema for the Auth Module (PostgreSQL)
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  // Null for accounts created via Google sign-in (no local password set).
  passwordHash String?      @map("password_hash")
  googleId     String?      @unique @map("google_id")
  role         Role         @default(USER)
  status       UserStatus   @default(ACTIVE)
  provider     AuthProvider @default(LOCAL)
  // Groundwork for multi-tenant support: nullable today, made required
  // and indexed once tenant isolation is introduced.
  tenantId     String?      @map("tenant_id")
  // IANA zone (e.g. "Asia/Ho_Chi_Minh") used to cut "today" for the board
  // agenda/metrics; falls back to the app default when unset.
  timezone     String?      @map("timezone")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  refreshTokens     RefreshToken[]
  passwordResetOtps PasswordResetOtp[]
  tasksAssigned     Task[]             @relation("TaskAssignee")
  tasksCreated      Task[]             @relation("TaskCreator")
  mailAccounts      MailAccount[]
  zaloAccount       ZaloAccount?
  zaloLinkCodes     ZaloLinkCode[]
  boards            Board[]
  projects          Project[]
  themePreference   UserThemePreference?

  @@index([email])
  @@map("users")
}

/// Không gian làm việc cá nhân: cách một người tự chia nhóm công việc của
/// chính mình. **Không có thành viên, không phân quyền** — mỗi dự án thuộc
/// đúng một người và chỉ người đó thấy nó.
///
/// `projectId` là lớp phân vùng dữ liệu chứ không phải bộ lọc tuỳ chọn: một
/// việc thuộc đúng một dự án và không nhìn thấy được từ dự án khác.
model Project {
  id      String @id @default(uuid())
  ownerId String @map("owner_id")

  /// 2–8 ký tự HOA, chữ và số. Bỏ trống thì backend sinh từ `name`.
  code        String  @db.VarChar(8)
  name        String  @db.VarChar(80)
  description String? @db.VarChar(280)
  /// `#rrggbb`
  color       String  @db.VarChar(7)
  /// Danh sách đóng, xem `PROJECT_ICONS`.
  icon        String  @db.VarChar(20)
  /// Tối đa một dự án mặc định mỗi người. Prisma không diễn đạt được ràng buộc
  /// "một phần" này nên nó nằm ở partial unique index trong migration, cộng
  /// thêm transaction ở `setDefault` — cố tình làm cả hai.
  isDefault   Boolean @default(false) @map("is_default")
  archived    Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks  Task[]
  boards Board[]

  // Trùng tên/mã chỉ bị chặn TRONG phạm vi một người dùng — hai người khác
  // nhau đều được có dự án tên "Việc nhà".
  @@unique([ownerId, code])
  @@unique([ownerId, name])
  @@index([ownerId, archived])
  @@map("projects")
}

/// Giao diện người dùng tự chỉnh (ảnh nền, màu nhấn, độ trong của khung).
/// Quan hệ 1–1 nên `userId` làm luôn khoá chính — không có cột `id` riêng.
model UserThemePreference {
  userId     String @id @map("user_id")
  /// id preset nền do frontend định nghĩa. Cố tình là chuỗi chứ không phải
  /// enum: thêm một ảnh nền ở FE mà phải chạy migration đổi enum là ràng
  /// buộc chéo không đáng có.
  background String @db.VarChar(40)
  /// `#rrggbb`. VarChar chứ không phải Char(7): Postgres `char` đệm/cắt
  /// khoảng trắng, mà FE so sánh chuỗi để tô ô màu đang chọn.
  accent     String @db.VarChar(7)
  /// Double chứ không phải Decimal: driver trả `numeric` về dạng chuỗi
  /// ("0.70"), còn hợp đồng với FE yêu cầu JSON number.
  surfaceOpacity Float    @map("surface_opacity")
  surfaceBlur    Int      @map("surface_blur") @db.SmallInt
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_theme_preferences")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  // SHA-256 hash of the raw refresh token; the raw value only ever
  // lives in the HttpOnly cookie, never persisted.
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  // Points at the token that replaced this one, so a rotation chain
  // can be audited/replayed if a reused (stolen) token is detected.
  replacedByTokenId String?   @map("replaced_by_token_id")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_otps")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskCategory {
  WORK
  PERSONAL
}

model TaskType {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tasks Task[]

  @@map("task_types")
}

model Task {
  id          String  @id @default(uuid())
  // Sequential number used to render a human-friendly code (e.g. TSK-000123).
  seq         Int     @default(autoincrement())
  title       String
  description String?
  note        String?

  taskTypeId String?      @map("task_type_id")
  category   TaskCategory @default(WORK)
  priority   TaskPriority @default(NORMAL)
  status     TaskStatus   @default(TODO)

  // Links or filenames found in the task source (e.g. attachments/links in the source mail).
  attachments String[] @default([]) @map("attachments")

  assigneeId String  @map("assignee_id")
  creatorId  String? @map("creator_id")

  assignedAt  DateTime? @map("assigned_at")
  deadline    DateTime? @map("deadline")
  completedAt DateTime? @map("completed_at")

  // Groundwork for a future Lark (Feishu) sync integration; unused today.
  externalSyncStatus String? @map("external_sync_status")
  externalRef        String? @map("external_ref")

  // The connected mailbox (MailAccount) that ingested this task from an email, if any.
  sourceMailAccountId String? @map("source_mail_account_id")

  // Set once a Zalo deadline reminder has fired, so the hourly cron never re-notifies.
  deadlineNotifiedAt DateTime? @map("deadline_notified_at")

  /// Lớp phân vùng: việc thuộc đúng một dự án, và dự án đó luôn là của
  /// `assignee` (không phải của người tạo, cũng không phải của chủ hộp thư đã
  /// ingest ra nó).
  projectId String @map("project_id")

  // --- Personal board (see docs board-spec) ---
  boardId String? @map("board_id")
  // null = sitting in the Inbox (auto-ingested, not filed into a list yet).
  listId  String? @map("list_id")
  // Sparse float ordering: dropping between two cards writes the average of
  // their positions, so a reorder only ever updates one row.
  position Float  @default(1024)
  // CSS gradient or image URL rendered as the card cover.
  cover           String? @map("cover")
  estimateMinutes Int?    @map("estimate_minutes")
  repeatUnit      RepeatUnit? @map("repeat_unit")
  repeatInterval  Int?        @map("repeat_interval")
  // Advanced recurrence. All of these only mean anything when `repeatUnit` is
  // set; a card with no unit is not a repeating card no matter what is here.
  //
  // `repeatWeekdays`: 0=Sunday .. 6=Saturday, only for WEEK. Empty = keep the
  // weekday the deadline already falls on, which is the old behaviour.
  // `repeatDayOfMonth`: 1..31, only for MONTH. A month too short clamps to its
  // last day (31 -> 30 in April), it never rolls into the next month.
  // `repeatUntil` / `repeatRemaining`: when to stop. Both null = forever.
  // `repeatRemaining` counts occurrences STILL TO COME after this one, so each
  // spawned card carries one less than its parent and 0 ends the series.
  repeatWeekdays   Int[]     @map("repeat_weekdays")
  repeatDayOfMonth Int?      @map("repeat_day_of_month")
  repeatUntil      DateTime? @map("repeat_until")
  repeatRemaining  Int?      @map("repeat_remaining")
  // Soft delete, so the frontend's Ctrl+Z can restore a card with its
  // checklists and notes intact.
  deletedAt DateTime? @map("deleted_at")

  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskType          TaskType?    @relation(fields: [taskTypeId], references: [id])
  assignee          User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator           User?        @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  sourceMailAccount MailAccount? @relation(fields: [sourceMailAccountId], references: [id], onDelete: SetNull)

  board           Board?           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  list            TaskList?        @relation(fields: [listId], references: [id], onDelete: SetNull)
  labels          TaskLabel[]
  checklists      Checklist[]
  attachmentFiles TaskAttachment[]
  notes           TaskNote[]
  activities      TaskActivity[]

  @@index([assigneeId])
  @@index([status])
  @@index([deadline])
  @@index([sourceMailAccountId])
  @@index([listId, position])
  @@index([boardId, listId])
  @@index([boardId, deadline])
  @@index([projectId, status])
  @@map("tasks")
}

enum RepeatUnit {
  DAY
  WEEK
  MONTH
}

/// Một bảng cho mỗi dự án của mỗi người. Trước đây là `ownerId @unique`
/// (đúng một bảng mỗi người); ràng buộc đó đã nới thành `@@unique([ownerId,
/// projectId])` khi dự án ra đời.
///
/// Hệ quả quan trọng: **không còn suy được bảng từ riêng `userId`**. Muốn lấy
/// bảng phải có thêm `projectId`, hoặc suy ngược từ chính bản ghi con
/// (`Task.boardId`) — xem `BoardAccessService`.
model Board {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  projectId String   @map("project_id")
  title     String
  starred   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner   User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lists   TaskList[]
  labels  BoardLabel[]
  tasks   Task[]

  @@unique([ownerId, projectId])
  @@map("boards")
}

model TaskList {
  id       String  @id @default(uuid())
  boardId  String  @map("board_id")
  title    String
  position Float
  archived Boolean @default(false)
  wipLimit Int?    @map("wip_limit")
  // When set, moving a card into this list rewrites Task.status, keeping the
  // legacy /kanban + stats screens correct. null = the list does not touch status.
  mapsToStatus TaskStatus? @map("maps_to_status")
  createdAt    DateTime    @default(now()) @map("created_at")

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, position])
  @@map("task_lists")
}

model BoardLabel {
  id      String @id @default(uuid())
  boardId String @map("board_id")
  name    String
  color   String
  // Icon name from the frontend's closed list (see LABEL_ICONS). null = the
  // label shows as a plain colour chip, which is what every existing label is.
  icon    String?
  // Diacritic-free form the frontend quick-add matches ("#baogia").
  slug    String

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks TaskLabel[]

  @@unique([boardId, slug])
  @@index([boardId])
  @@map("board_labels")
}

model TaskLabel {
  taskId  String @map("task_id")
  labelId String @map("label_id")

  task  Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label BoardLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

model Checklist {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  title     String
  position  Float
  createdAt DateTime @default(now()) @map("created_at")

  task  Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([taskId, position])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(uuid())
  checklistId String    @map("checklist_id")
  content     String
  checked     Boolean   @default(false)
  position    Float
  checkedAt   DateTime? @map("checked_at")

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, position])
  @@map("checklist_items")
}

enum AttachmentKind {
  IMAGE
  FILE
  LINK
}

model TaskAttachment {
  id        String         @id @default(uuid())
  taskId    String         @map("task_id")
  name      String
  kind      AttachmentKind
  url       String
  sizeBytes Int?           @map("size_bytes")
  isCover   Boolean        @default(false) @map("is_cover")
  createdAt DateTime       @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

/// Personal note — no authorId: the board owner is always the author.
model TaskNote {
  id        String    @id @default(uuid())
  taskId    String    @map("task_id")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_notes")
}

enum ActivityAction {
  CARD_CREATED
  CARD_MOVED
  CARD_COMPLETED
  CARD_REOPENED
  DUE_CHANGED
  SNOOZED
  CHECKLIST_ITEM_CHECKED
  ATTACHMENT_ADDED
  NOTE_ADDED
}

/// Own-actions log — no actorId: the board owner is always the actor.
model TaskActivity {
  id     String         @id @default(uuid())
  taskId String         @map("task_id")
  action ActivityAction
  // Pre-rendered Vietnamese sentence, frozen at write time so renaming a list
  // later does not rewrite history.
  message   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_activities")
}

enum MailProvider {
  GOOGLE
}

model MailAccount {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  provider       MailProvider @default(GOOGLE)
  email          String
  // AES-256-GCM ciphertext ("iv:authTag:cipherText" hex) — never stored as plaintext.
  accessToken    String       @map("access_token")
  refreshToken   String       @map("refresh_token")
  tokenExpiresAt DateTime     @map("token_expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, email])
  @@map("mail_accounts")
}

model ZaloAccount {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  zaloUserId String   @unique @map("zalo_user_id")
  linkedAt   DateTime @default(now()) @map("linked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("zalo_accounts")
}

// Short-lived code a user sends as a Zalo message to the bot to prove
// ownership of that Zalo account and complete the link.
model ZaloLinkCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  code      String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("zalo_link_codes")
}
